{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/webhook",
      "destination": "/api/index.py"
    },
    {
      "source": "/upload",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/upload"
    },
    {
      "source": "/hosturl",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/hosturl"
    },
    {
      "source": "/v/(.*)",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/v/$1"
    },
    {
      "source": "/api/1/upload",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/api/1/upload"
    },
    {
      "source": "/api/upload",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/api/upload"
    },
    {
      "source": "/api/sharex",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/api/sharex"
    },
    {
      "source": "/api/info",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/api/info"
    },
    {
      "source": "/api/delete",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/api/delete"
    },
    {
      "source": "/admin(.*)",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/admin$1"
    },
    {
      "source": "/docs(.*)",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/docs$1"
    },
    {
      "source": "/pricing(.*)",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/pricing$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
