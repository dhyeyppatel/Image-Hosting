{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/webhook",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin(.*)",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/admin$1"
    },
    {
      "source": "/docs(.*)",
      "destination": "https://media-hosting.dhyeyp254.workers.dev/docs$1"
    }
  ]
}
